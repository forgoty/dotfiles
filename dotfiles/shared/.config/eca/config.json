{
  "$schema": "https://eca.dev/config.json",
  "chatRetentionDays": 365,
  "autoCompactPercentage": 90,
  "extraConfigs": [
      "~/.config/eca/config.local.json"
  ],
  "defaultModel": "github-copilot/gpt-4.1",

  "mcpServers": {
    "github": {
      "command": "podman",
      "args": [
        "run",
        "-i",
        "--rm",
        "ghcr.io/github/github-mcp-server"
      ]
    },
    "serena": {
      "command": "uvx",
      "args": ["--from", "git+https://github.com/oraios/serena", "serena", "start-mcp-server"]
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    }
  },

  "plugins": {
    "forgoty-marketplace": {
      "source": "/home/nikita/.config/agents/forgoty-marketplace"
    },
    "install": ["software-engineering"]
  },

  "toolCall": {
    "approval": {
      "allow": {
        "github__get_me": {},
        "github__get_file_contents": {},
        "github__get_commit": {},
        "github__get_tag": {},
        "github__get_release_by_tag": {},
        "github__get_latest_release": {},
        "github__get_label": {},
        "github__get_team_members": {},
        "github__get_teams": {},
        "github__list_branches": {},
        "github__list_commits": {},
        "github__list_issues": {},
        "github__list_pull_requests": {},
        "github__list_releases": {},
        "github__list_tags": {},
        "github__list_repository_collaborators": {},
        "github__list_issue_fields": {},
        "github__list_issue_types": {},
        "github__search_code": {},
        "github__search_commits": {},
        "github__search_issues": {},
        "github__search_pull_requests": {},
        "github__search_repositories": {},
        "github__search_users": {},
        "github__pull_request_read": {},
        "github__issue_read": {},
        "serena__activate_project": {},
        "serena__read_file": {},
        "serena__list_dir": {},
        "serena__find_file": {},
        "serena__search_for_pattern": {},
        "serena__get_symbols_overview": {},
        "serena__find_symbol": {},
        "serena__find_referencing_symbols": {},
        "serena__find_implementations": {},
        "serena__find_declaration": {},
        "serena__get_diagnostics_for_file": {},
        "serena__list_memories": {},
        "serena__read_memory": {},
        "serena__get_current_config": {},
        "serena__initial_instructions": {},
        "serena__onboarding": {},
        "context7__resolve-library-id": {},
        "context7__query-docs": {}
      },
      "deny": {
        "eca__shell_command": {
          "argsMatchers": {
            "command": [
              ".*\\bgit\\b.*\\b(push|commit|add|rebase|checkout|pull|fetch|merge|reset)\\b.*$"
            ]
          }
        },
        "eca__git": {
          "argsMatchers": {
            "operation": [
              "commit",
              "push",
              "merge",
              "rebase",
              "stash",
              "checkout"
            ]
          }
        }
      }
    }
  }
}
